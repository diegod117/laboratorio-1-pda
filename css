:root {
  --bg-dark: #1A1A2E;
  --accent: #0F8B8D;
  --text-light: #F5F5F5;
  --card-bg: #FFFFFF;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background-color: var(--bg-dark);
  color: var(--text-light);
  font-family: 'Inter', sans-serif;
  font-weight: 400;
  line-height: 1.6;
}

header {
  padding: 40px 24px;
  text-align: center;
}

header h1 {
  font-family: 'Poppins', sans-serif;
  font-weight: 700;
  margin: 0;
}

main {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 24px 60px;
  display: flex;
  flex-direction: column;
  gap: 32px;
}